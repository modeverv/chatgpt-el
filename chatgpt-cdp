import itertools
import json
import requests
import sys
import time
import collections

from perlcompat import die, warn, getopts
import tbdump
import websocket

DEFAULT_TIMEOUT = 10

Config = collections.namedtuple('Config',
                                'url form_sel button_sel response_sel')

CONFIGS = {
    'chatgpt':
    Config(
        url='https://chatgpt.com',
        form_sel='div#prompt-textarea',
        button_sel=
        'button[data-testid="send-button"], button[data-testid="stop-button"], button[data-testid="fruitjuice-send-button"], button[data-testid="fruitjuice-stop-button"]',
        response_sel=
        '[data-message-author-role="assistant"], .agent-turn article'),
    'gemini':
    Config(url='https://gemini.google.com/',
           form_sel=
           'div.textarea[contenteditable="true"], div[role="textbox"][contenteditable="true"], div.textarea',
           button_sel=
           'button[aria-label="Send message"], button[aria-label="プロンプトを送信"], button[aria-label*="送信"], button.send-button.submit, button[aria-label*="Stop"], button[aria-label*="停止"]',
           response_sel='response-container'),
    'openwebui':
    Config(url='http://vcserv:8080/',
           form_sel='div#chat-input',
           button_sel='button#send-message-button',
           response_sel='div#response-content-container'),
    'claude':
    Config(url='https://claude.ai/',
           form_sel=
           'div[data-testid="chat-input"][contenteditable="true"], div[role="textbox"][contenteditable="true"], p[data-placeholder]',
           button_sel=
           'button[aria-label="Send message"], button[aria-label="Send Message"], button[aria-label="メッセージを送信"], button[aria-label*="送信"], button[aria-label*="Stop"], button[aria-label*="停止"]',
           response_sel='div[data-test-render-count]'),
    'copilot':
    Config(url='https://copilot.microsoft.com/',
           form_sel='textarea[placeholder="Message Copilot"]',
           button_sel=
           'button[aria-label="Submit message"], button[aria-label*="Stop"]',
           response_sel='div[role="article"]'),
    'copilot-enterprise':
    Config(url='https://m365.cloud.microsoft/chat/',
           form_sel='span[aria-label="Message Copilot"]',
           button_sel='button[aria-label="Send"], button[aria-label*="Stop"]',
           response_sel='div[data-testid="markdown-reply"]'),
    'perplexity':
    Config(url='https://www.perplexity.ai/',
           form_sel='div#ask-input[contenteditable="true"]',
           button_sel=
           'button[aria-label*="停止"], button[aria-label*="Stop"], button[aria-label="送信"], button[aria-label="Submit"]',
           response_sel='div[id^="markdown-content-"]'),
}

def usage():
    die(f"""\
usage: {sys.argv[0]} [-v] [-I] [-e engine] [-m model] [-s prompt] [-r] [-u] [-T] [-J] [-U url]
  -v              enable verbose mode
  -I              open the AI engine in the browser and exit
  -e engine       AI engine to use (e.g., chatgpt, gemini, claude, perplexity) (default: chatgpt)
  -m model        specify a model (if supported by the engine)
  -s prompt       submit the specified prompt to the AI engine
  -r              Retrieve the current response in HTML format
  -u              Print the current browser page URL
  -T              Print the current browser page title
  -J              Print the current browser page metadata as JSON
  -U url          Navigate the browser page to url
""")

id_counter = itertools.count(1)

def cdb_send(ws, method, params=None):
    id_ = next(id_counter)
    req = {'id': id_, 'method': method}
    if params:
        req['params'] = params
    ws.send(json.dumps(req))
    ws.settimeout(DEFAULT_TIMEOUT)
    while True:
        resp = json.loads(ws.recv())
        if resp.get('id') == id_:
            return resp

def wait_until_visible(ws, selector):
    js = f"""
(function() {{
    return Array.from(document.querySelectorAll('{selector}')).some(el => {{
        const style = window.getComputedStyle(el);
        return (style && style.display !== 'none' &&
                style.visibility !== 'hidden');
    }});
}})()
"""
    for i in range(DEFAULT_TIMEOUT):
        resp = cdb_send(ws, 'Runtime.evaluate', {'expression': js})
        if resp['result']['result']['value']:
            return
        time.sleep(1)
    raise TimeoutError

def open_wsocket(config):
    resp = requests.get('http://127.0.0.1:9000/json/list',
                        timeout=DEFAULT_TIMEOUT)
    pages = reversed([elem for elem in resp.json() if elem['type'] == 'page'])
    for page in pages:
        if config.url in page.get('url'):
            break
    url = page.get('webSocketDebuggerUrl')
    ws = websocket.create_connection(url)
    cdb_send(ws, 'Page.enable')
    if config.url not in page.get('url'):
        cdb_send(ws, 'Page.navigate', {'url': config.url})
    return ws

def send_prompt(config, prompt):
    ws = open_wsocket(config)

    wait_until_visible(ws, config.form_sel)
    js = f"""
Array.from(document.querySelectorAll('{config.form_sel}'))
    .find(el => {{
        const style = window.getComputedStyle(el);
        return (style && style.display !== 'none' &&
                style.visibility !== 'hidden');
    }}).focus();
"""
    cdb_send(ws, 'Runtime.evaluate', {'expression': js})
    cdb_send(ws, 'Input.insertText', {'text': prompt})

    wait_until_visible(ws, config.button_sel)
    js = f"""
Array.from(document.querySelectorAll('{config.button_sel}'))
    .find(el => {{
        const style = window.getComputedStyle(el);
        return (style && style.display !== 'none' &&
                style.visibility !== 'hidden' && !el.disabled);
    }}).click();
"""
    cdb_send(ws, 'Runtime.evaluate', {'expression': js})

def recv_response(config):
    ws = open_wsocket(config)

    wait_until_visible(ws, config.response_sel)
    js = f"""
(() => {{
    const nodes = Array.from(document.querySelectorAll('{config.response_sel}'))
        .filter(el => (el.innerText || '').trim().length > 0);
    const last = nodes[nodes.length - 1];
    return last ? last.innerHTML : null;
}})()
"""
    resp = cdb_send(ws, 'Runtime.evaluate', {'expression': js})
    content = resp['result']['result'].get('value')
    print(content)

    js = f"""
(() => {{
    const btn = document.querySelector('{config.button_sel}');
    if (!btn) return null;
    return (btn.getAttribute('data-testid') || '') + ' ' +
           (btn.getAttribute('aria-label') || '');
}})()
"""
    resp = cdb_send(ws, 'Runtime.evaluate', {'expression': js})
    state = (resp['result']['result'].get('value') or '').lower()
    if 'stop' not in state and '停止' not in state:
        print('EOF')

def current_url(config):
    ws = open_wsocket(config)
    resp = cdb_send(ws, 'Runtime.evaluate',
                    {'expression': 'window.location.href'})
    print(resp['result']['result'].get('value') or '')

def current_title(config):
    ws = open_wsocket(config)
    resp = cdb_send(ws, 'Runtime.evaluate',
                    {'expression': 'document.title'})
    print(resp['result']['result'].get('value') or '')

def current_metadata(config, engine):
    ws = open_wsocket(config)
    resp = cdb_send(ws, 'Runtime.evaluate', {
        'expression': """JSON.stringify({
            title: document.title || "",
            url: window.location.href || "",
            llm: %s
        })""" % json.dumps(engine)
    })
    content = resp['result']['result'].get('value') or '{}'
    print(content)

def navigate_url(config, url):
    ws = open_wsocket(config)
    cdb_send(ws, 'Page.navigate', {'url': url})

def main():
    opt = getopts('vIe:m:s:ruTJU:') or usage()
    verbose = opt.v
    engine = opt.e.lower() if opt.e else 'chatgpt'
    model = opt.m
    config = CONFIGS[engine]
    if opt.I:
        ws = open_wsocket(config)
        sys.exit()
    if opt.r:
        recv_response(config)
    elif opt.u:
        current_url(config)
    elif opt.T:
        current_title(config)
    elif opt.J:
        current_metadata(config, engine)
    elif opt.U:
        navigate_url(config, opt.U)
    else:
        prompt = opt.s if opt.s else sys.stdin.read().strip()
        send_prompt(config, prompt)

if __name__ == "__main__":
    main()
